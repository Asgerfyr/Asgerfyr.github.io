{
  "type": "module",
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:pages": "tsx scripts/component-renderer.js",
    "build:js": "esbuild src/app.ts --bundle --outfile=dist/app.js --target=es2020 --format=iife",
    "build": "npm run build:pages && npm run build:js",
    "watch": "esbuild src/app.ts --bundle --outfile=dist/app.js --target=es2020 --format=iife --watch"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "lucide": "^1.31.0"
  },
  "allowScripts": {
    "esbuild@0.20.2": true,
    "esbuild@0.28.2": true
  }
}
